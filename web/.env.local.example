# Privy app id (from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=

# Deployed contract addresses (copy from ../deployments.json after `npm run deploy`)
NEXT_PUBLIC_POLICY_VAULT=
NEXT_PUBLIC_SCAM_REGISTRY=
NEXT_PUBLIC_MOCK_USD=
NEXT_PUBLIC_AJO_CIRCLE=

# Chainlink price feeds on Monad mainnet (read-only; wallet funds stay on testnet)
NEXT_PUBLIC_CL_BTC_USD=0x187efD8ba8483105f2735740D956f7CD23723deC
NEXT_PUBLIC_CL_ETH_USD=0x38057D0458ca56068e1A57E62D3874cA129A7A78

# Optional RPC overrides
NEXT_PUBLIC_MONAD_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_MAINNET_RPC=https://rpc.monad.xyz

# AI parser: any OpenAI-compatible endpoint. Leave LLM_API_KEY blank to use the
# built-in rules-based parser (the demo still works without a key).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional fallback AI provider (server-side only)
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODEL=

# Optional authenticated contact sync (server-side only)
PRIVY_APP_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also supported.

# Display rate: naira per 1 cUSD (= 1 USD) for the UI
NEXT_PUBLIC_NGN_PER_USD=1600
